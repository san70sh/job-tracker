# Copy to .env and uncomment what you need. Everything has a default except the database password.
# .env is git-ignored. Never commit it, and never paste its contents into a chat.

# Database: the app role ('jobtracker') on your PostgreSQL service. Replace YOUR_PASSWORD.
# If the password contains @ / # : % or a space, write them as %40 %2F %23 %3A %25 %20,
# or use the key-value form instead:  DATABASE_URL=host=localhost port=5432 dbname=jobtracker user=jobtracker password=YOUR_PASSWORD
# DATABASE_URL=postgresql://jobtracker:YOUR_PASSWORD@localhost:5432/jobtracker
# (The read-only role used for DBeaver is separate; its password does NOT go in this file.)

# Optional LLM fallback for postings the rules cannot read
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5

# Browser extension (extension/): create the value with  uv run python -m jobtracker capture-token
# CAPTURE_TOKEN=

# Optional read-only Notion mirror
# NOTION_TOKEN=
# NOTION_DATA_SOURCE_ID=

# Tuning
# REMINDER_AFTER_DAYS=2
# CONFIDENCE_THRESHOLD=0.8
# PER_HOST_DELAY=1.0
